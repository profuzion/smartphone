      "id": "pz-proc-txt",
      "name": "text-basic",
      "parent": "pz-proc-c",
      "children": [],
      "settings": {
        "text": "01 Listen (Week 1) — We start at the desk you actually work from.\n02 Frame (Weeks 2–3) — Positioning, voice, and the shape of the work.\n03 Design (Weeks 3–6) — Identity and screens — drawn together, not in series.\n04 Ship (Weeks 6–8) — Built, tested, indexed, handed over. (Stack: align with your Bricks/WordPress build.)\n05 Tend (ongoing) — Quarterly rounds keep the work earning its keep."
      },
      "label": "Phases"
    },
