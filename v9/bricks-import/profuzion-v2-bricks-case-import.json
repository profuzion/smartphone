    {
      "id": "pz-case-cta-code",
      "name": "html",
      "parent": "pz-case-cta-c",
      "children": [],
      "settings": {
        "html": "<section class=\"pfz-section pfz-section--ink pfz-case__cta\" aria-labelledby=\"case-cta-shout\">\n  <div class=\"pfz-case__cta-noise\" aria-hidden=\"true\"></div>\n  <div class=\"pfz-case__cta-inner\">\n    <p id=\"case-cta-shout\" class=\"pfz-case__cta-shout\">\n      WHAT GOT YOU HERE <span class=\"pfz-italic pfz-display--primary\">won't</span> GET YOU THERE.\n    </p>\n    <p class=\"pfz-body pfz-case__cta-lede\">\n      Not a traditional bloated agency — a founder-led studio for owners who need the work to read clearly the first time. Grab a call and we'll map the next evolution.\n    </p>\n    <div class=\"pfz-case__cta-actions\">\n      <a href=\"/#contact\" class=\"btn--secondary\" data-cursor data-cursor-label=\"book\">\n        Book a 30-min call <span class=\"pfz-btn-arrow\">→</span>\n      </a>\n      <a href=\"mailto:hello@profuzionstudio.com\" class=\"btn--base btn--outline\" data-cursor data-cursor-label=\"email\">\n        hello@profuzionstudio.com\n      </a>\n    </div>\n  </div>\n</section>"
      },
      "label": "CTA content"
    },
    {
      "id": "pz-case-rel-s",
      "name": "section",
      "parent": 0,
      "children": [
        "pz-case-rel-c"
      ],
      "settings": {
        "tag": "section",
        "_cssId": "case-related-sec",
        "_padding": {
          "top": "48",
