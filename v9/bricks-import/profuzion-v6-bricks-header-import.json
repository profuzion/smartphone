      "settings": {
        "html": "<style id=\"pfz-site-layout\">\n/* sr-only — visually hidden, screen-reader accessible. Required by\n * the v6 case template (`<h2 className=\"sr-only\">Summary</h2>` etc.) */\n.pfz .sr-only,\nbody.pfz .sr-only {\n  position: absolute !important;\n  width: 1px !important;\n  height: 1px !important;\n  padding: 0 !important;\n  margin: -1px !important;\n  overflow: hidden !important;\n  clip: rect(0, 0, 0, 0) !important;\n  white-space: nowrap !important;\n  border: 0 !important;\n}\n\n/* ═══════════════════════════════════════════════════════════════════\n * Custom cursor — chartreuse ring + dot, matching v6 React preview.\n *\n * cursor.js (in child theme assets/js/) creates `#pz-cursor-root`\n * with `.pz-cursor-ring` + `.pz-cursor-dot` + `.pz-cursor-label`\n * children, and rAF-animates them. v2.css's `cursor: none` rule\n * hides the native cursor; this block styles the JS-rendered\n * elements so they actually become visible.\n * ─────────────────────────────────────────────────────────────── */\n\n#pz-cursor-root {\n  position: fixed;\n  inset: 0;\n  pointer-events: none;\n  z-index: 9999;\n}\n\n.pz-cursor-ring {\n  position: fixed;\n  left: 0;\n  top: 0;\n  width: 18px;\n  height: 18px;\n  border-radius: 50%;\n  border: 1px solid rgba(255, 255, 255, 0.45);\n  background: transparent;\n  pointer-events: none;\n  z-index: 9999;\n  display: none;\n  transition:\n    width 220ms cubic-bezier(0.2, 0.8, 0.2, 1),\n    height 220ms cubic-bezier(0.2, 0.8, 0.2, 1),\n    background 220ms cubic-bezier(0.2, 0.8, 0.2, 1),\n    border-color 220ms cubic-bezier(0.2, 0.8, 0.2, 1);\n  will-change: transform, width, height, background;\n}\n\n.pz-cursor-dot {\n  position: fixed;\n  left: 0;\n  top: 0;\n  width: 4px;\n  height: 4px;\n  border-radius: 50%;\n  background: var(--primary, #b6ff38);\n  box-shadow: 0 0 8px 1px var(--primary-glow, rgba(182, 255, 56, 0.45));\n  pointer-events: none;\n  z-index: 9999;\n  display: none;\n  transition: opacity 200ms cubic-bezier(0.2, 0.8, 0.2, 1);\n  will-change: transform, opacity;\n}\n\n.pz-cursor-label {\n  position: absolute;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  font-family: var(--text-mono);\n  font-size: 10px;\n  font-weight: 500;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--on-primary, #0a0a0b);\n  opacity: 0;\n  transition: opacity 200ms ease;\n  pointer-events: none;\n}\n\n@media (hover: hover) and (pointer: fine) and (min-width: 768px) {\n  .pz-cursor-ring,\n  .pz-cursor-dot {\n    display: block;\n  }\n}\n\n/* Re-assert v2.css `cursor: none` so native is hidden on hover-fine\n * devices, but keep `auto` on form inputs (text caret) and outside the\n * `.pfz` scope (admin bar etc). */\n@media (hover: hover) and (pointer: fine) {\n  body.pfz,\n  body.pfz *,\n  .pfz,\n  .pfz * {\n    cursor: none !important;\n  }\n  body.pfz input[type=\"text\"],\n  body.pfz input[type=\"email\"],\n  body.pfz input[type=\"tel\"],\n  body.pfz input[type=\"url\"],\n  body.pfz input[type=\"search\"],\n  body.pfz input[type=\"password\"],\n  body.pfz input[type=\"number\"],\n  body.pfz textarea {\n    cursor: text !important;\n  }\n}\n@media (hover: none), (pointer: coarse) {\n  body.pfz,\n  body.pfz * {\n    cursor: auto !important;\n  }\n  body.pfz a,\n  body.pfz button,\n  body.pfz [data-cursor] {\n    cursor: pointer !important;\n  }\n}\n\n/* ═══════════════════════════════════════════════════════════════════\n * Industries — preview crossfade.\n * 4 IndustryPreview cards live in the same sticky column. Only the\n * active one is visible; hovering an industry row swaps via JS.\n * ─────────────────────────────────────────────────────────────── */\n\n.pfz-home__ind-preview-stack {\n  position: relative;\n  width: 100%;\n}\n\n.pfz-home__ind-preview-card {\n  display: none;\n}\n.pfz-home__ind-preview-card.is-active {\n  display: block;\n}\n\n@media (min-width: 1024px) {\n  .pfz-home__ind-preview-stack {\n    min-height: 480px;\n  }\n  .pfz-home__ind-preview-card {\n    display: block;\n    position: absolute;\n    inset: 0;\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 320ms cubic-bezier(0.2, 0.8, 0.2, 1);\n    z-index: 0;\n  }\n  .pfz-home__ind-preview-card.is-active {\n    position: relative; /* gives the stack its height */\n    opacity: 1;\n    pointer-events: auto;\n    z-index: 1;\n  }\n}\n\n/* ═══════════════════════════════════════════════════════════════════\n * Websites — sticky browser frame + mockup crossfade.\n * 4 mockups stack inside the frame body; IntersectionObserver on\n * the slots swaps which one is visible.\n * ─────────────────────────────────────────────────────────────── */\n\n.pfz-home__web-mockup-layer {\n  position: absolute;\n  inset: 0;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 480ms cubic-bezier(0.2, 0.8, 0.2, 1);\n}\n.pfz-home__web-mockup-layer.is-active {\n  opacity: 1;\n  pointer-events: auto;\n}\n\n/* Hero & section padding polish — bumped specificity so Bricks's\n * frontend rules can't beat the lg-breakpoint padding overrides. */\n\nbody.pfz .pfz-home__hero-inner {\n  padding: 7rem 1.5rem 4rem !important;\n}\n@media (min-width: 1024px) {\n  body.pfz .pfz-home__hero-inner {\n    padding: 8rem 2.5rem 6rem !important;\n  }\n}\nbody.pfz .pfz-home__shell {\n  padding-inline: 1.5rem !important;\n}\n@media (min-width: 1024px) {\n  body.pfz .pfz-home__shell {\n    padding-inline: 2.5rem !important;\n  }\n}\nbody.pfz .pfz-home__nav {\n  padding-inline: 1.5rem !important;\n}\n@media (min-width: 1024px) {\n  body.pfz .pfz-home__nav {\n    padding-inline: 2.5rem !important;\n  }\n}\nbody.pfz .pfz-home__foot-inner {\n  padding-inline: 1.5rem !important;\n}\n@media (min-width: 1024px) {\n  body.pfz .pfz-home__foot-inner {\n    padding-inline: 2.5rem !important;\n  }\n}\n\n/* ═══════════════════════════════════════════════════════════════════\n * Homepage section layouts (Bricks-rendered v6 home page).\n *\n * The Next.js v6 preview gets layout from Tailwind utility classes and\n * React inline styles which don't ship to WordPress. These rules give\n * the Bricks home page identical layouts via plain CSS classes that\n * the generators in scripts/lib/bricks-home-content.mjs apply.\n *\n * Naming: pfz-home__<section>-<part> (BEM, kept under .pfz so it scopes\n * cleanly with the rest of v2.css and doesn't leak to wp-admin).\n * ═══════════════════════════════════════════════════════════════════ */\n\n/* ── shared ── */\n\n.pfz .pfz-home__shell {\n  width: 100%;\n  max-width: 1480px;\n  margin-inline: auto;\n  padding-inline: 1.5rem;\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__shell {\n    padding-inline: 2.5rem;\n  }\n}\n\n.pfz .pfz-home__sec {\n  position: relative;\n  isolation: isolate;\n  background: var(--base);\n  color: var(--contrast);\n}\n\n.pfz .pfz-home__sec--ink {\n  background: var(--base-ultra-dark);\n}\n\n.pfz .pfz-home__sec--paper-light {\n  background: var(--base-light);\n}\n\n/* Section vertical rhythm — matches v6 React (py-24 lg:py-32) */\n.pfz .pfz-home__sec-pad {\n  padding-block: 6rem;\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__sec-pad {\n    padding-block: 8rem;\n  }\n}\n\n/* Hairline rule across full width (replaces Tailwind border-t pattern) */\n.pfz .pfz-rule {\n  height: 1px;\n  background: var(--border);\n  margin-block: 0;\n}\n.pfz .pfz-rule--ink {\n  background: var(--border-on-dark);\n}\n\n/* Section meta-row: eyebrow+H2 on left, supporting paragraph on right. */\n.pfz .pfz-home__meta-row {\n  margin-bottom: 4rem;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 1.5rem;\n}\n.pfz .pfz-home__meta-row--gap-lg {\n  margin-bottom: 5rem;\n}\n.pfz .pfz-home__meta-h2 {\n  margin-top: 0.75rem;\n  max-width: 48rem;\n}\n.pfz .pfz-home__meta-body {\n  max-width: 28rem;\n}\n\n/* ── §1 Hero ── */\n\n.pfz .pfz-home__hero {\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  background: var(--base);\n  color: var(--contrast);\n}\n\n.pfz .pfz-home__hero-darken,\n.pfz .pfz-home__hero-top-fade,\n.pfz .pfz-home__hero-void,\n.pfz .pfz-home__hero-bottom-fade {\n  position: absolute;\n  pointer-events: none;\n  z-index: 1;\n}\n.pfz .pfz-home__hero-darken {\n  inset: 0;\n  background: rgba(0, 0, 0, 0.5);\n}\n.pfz .pfz-home__hero-top-fade {\n  inset-inline: 0;\n  top: 0;\n  height: 8rem;\n  background: linear-gradient(180deg, rgba(5, 5, 7, 0.75) 0%, transparent 100%);\n}\n.pfz .pfz-home__hero-void {\n  inset: 0;\n  background: radial-gradient(\n    ellipse 68% 72% at 32% 52%,\n    rgba(5, 5, 7, 0.28) 0%,\n    rgba(5, 5, 7, 0.1) 42%,\n    transparent 72%\n  );\n}\n.pfz .pfz-home__hero-bottom-fade {\n  inset-inline: 0;\n  bottom: 0;\n  height: 10rem;\n  background: linear-gradient(\n    180deg,\n    transparent 0%,\n    var(--base) 70%,\n    var(--base) 100%\n  );\n}\n\n.pfz .pfz-home__hero-inner {\n  position: relative;\n  z-index: 2;\n  display: flex;\n  flex-direction: column;\n  min-height: 100svh;\n  width: 100%;\n  max-width: 1480px;\n  margin-inline: auto;\n  padding: 7rem 1.5rem 4rem;\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__hero-inner {\n    padding: 8rem 2.5rem 6rem;\n  }\n}\n\n.pfz .pfz-home__hero-meta {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  padding-bottom: 3rem;\n}\n\n.pfz .pfz-home__hero-headline {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\n\n.pfz .pfz-home__hero-h1 {\n  max-width: min(32ch, 100%);\n}\n\n.pfz .pfz-home__hero-lede {\n  margin-top: 2rem;\n  max-width: 42rem;\n  color: var(--secondary);\n}\n\n.pfz .pfz-home__hero-cta {\n  margin-top: 2.5rem;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.75rem;\n}\n\n.pfz .pfz-home__hero-bottom {\n  margin-top: 4rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n  border-top: 1px solid var(--border);\n  padding-top: 1.5rem;\n}\n@media (min-width: 640px) {\n  .pfz .pfz-home__hero-bottom {\n    flex-direction: row;\n    align-items: center;\n    justify-content: space-between;\n  }\n}\n\n.pfz .pfz-home__hero-vlist {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem 1.5rem;\n  font-family: var(--text-mono);\n  font-size: 11px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--contrast-muted);\n}\n.pfz .pfz-home__hero-vlist li {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n.pfz .pfz-home__hero-vlist-dot {\n  display: inline-block;\n  width: 4px;\n  height: 4px;\n  border-radius: 50%;\n  background: var(--contrast-muted-mid);\n}\n\n.pfz .pfz-home__hero-scroll {\n  font-family: var(--text-mono);\n  font-size: 11px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--contrast-muted-mid);\n}\n.pfz .pfz-home__hero-scroll strong {\n  font-weight: inherit;\n  color: var(--contrast);\n}\n\n/* Eyebrow with availability dot (pfz-eyebrow--primary already handles color) */\n.pfz .pfz-home__avail-dot {\n  display: inline-block;\n  width: 0.4em;\n  height: 0.4em;\n  border-radius: 50%;\n  margin-right: 0.5em;\n  background: var(--primary);\n  box-shadow: 0 0 10px 1px var(--primary-glow);\n  vertical-align: middle;\n}\n\n/* ── §2 Industries ── */\n\n.pfz .pfz-home__ind-body {\n  display: grid;\n  gap: 2.5rem;\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__ind-body {\n    grid-template-columns: 0.85fr 1.15fr;\n    gap: 3.5rem;\n  }\n}\n\n.pfz .pfz-home__ind-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n}\n.pfz .pfz-home__ind-list > li {\n  border-bottom: 1px solid var(--border);\n}\n\n.pfz .pfz-home__ind-row {\n  display: flex;\n  width: 100%;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1.5rem;\n  padding-block: 1.5rem;\n  text-align: left;\n  background: transparent;\n  border: 0;\n  color: var(--contrast-muted);\n  font-family: var(--text-sans);\n}\n.pfz .pfz-home__ind-row:hover,\n.pfz .pfz-home__ind-row:focus,\n.pfz .pfz-home__ind-row.is-active {\n  color: var(--contrast);\n}\n.pfz .pfz-home__ind-row-num {\n  font-family: var(--text-mono);\n  font-size: 12px;\n  letter-spacing: 0.16em;\n  color: var(--contrast-muted-low);\n  margin-right: 1.25rem;\n}\n.pfz .pfz-home__ind-row.is-active .pfz-home__ind-row-num {\n  color: var(--primary);\n}\n.pfz .pfz-home__ind-row-label {\n  font-size: clamp(1.5rem, 2.4vw, 2.25rem);\n  font-weight: 500;\n  letter-spacing: -0.025em;\n  line-height: 1.05;\n}\n.pfz .pfz-home__ind-row-meta {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  margin-left: 1rem;\n  font-family: var(--text-mono);\n  font-size: 11px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--contrast-muted-low);\n}\n.pfz .pfz-home__ind-row.is-active .pfz-home__ind-row-meta {\n  color: var(--primary);\n}\n.pfz .pfz-home__ind-row-meta::before {\n  content: \"\";\n  display: inline-block;\n  height: 1px;\n  width: 0.75rem;\n  background: var(--contrast-muted-low);\n}\n.pfz .pfz-home__ind-row.is-active .pfz-home__ind-row-meta::before {\n  width: 2rem;\n  background: var(--primary);\n}\n\n@media (min-width: 1024px) {\n  .pfz .pfz-home__ind-preview-col {\n    position: sticky;\n    top: 8rem;\n    align-self: start;\n  }\n}\n\n/* Industry preview card (procedural panel) */\n.pfz .pfz-card {\n  position: relative;\n  border-radius: 18px;\n  border: 1px solid var(--border-strong);\n  background: var(--base-light);\n  overflow: hidden;\n}\n\n.pfz .pfz-home__ind-preview {\n  min-height: 480px;\n  display: grid;\n  gap: 2rem;\n  padding: 2rem;\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__ind-preview {\n    padding: 2.5rem;\n  }\n}\n.pfz .pfz-home__ind-preview-bg {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n}\n.pfz .pfz-home__ind-preview-inner {\n  position: relative;\n  display: grid;\n  gap: 2rem;\n}\n.pfz .pfz-home__ind-preview-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n.pfz .pfz-home__ind-preview-kicker {\n  font-family: var(--text-mono);\n  font-size: 11px;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--contrast-muted-mid);\n}\n.pfz .pfz-home__ind-preview-dot {\n  display: inline-block;\n  width: 0.5rem;\n  height: 0.5rem;\n  border-radius: 50%;\n}\n.pfz .pfz-home__ind-preview-h3 {\n  font-size: clamp(1.75rem, 3.4vw, 3rem);\n  font-weight: 500;\n  letter-spacing: -0.03em;\n  line-height: 0.98;\n  color: var(--contrast);\n  max-width: 14ch;\n}\n.pfz .pfz-home__ind-preview-deliv {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 0.625rem;\n}\n@media (min-width: 640px) {\n  .pfz .pfz-home__ind-preview-deliv {\n    grid-template-columns: 1fr 1fr;\n  }\n}\n.pfz .pfz-home__ind-preview-deliv li {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  font-family: var(--text-sans);\n  font-size: 14px;\n  color: var(--secondary);\n}\n.pfz .pfz-home__ind-preview-deliv li::before {\n  content: \"\";\n  display: inline-block;\n  height: 1px;\n  width: 0.75rem;\n  background: currentColor;\n  opacity: 0.65;\n}\n.pfz .pfz-home__ind-preview-proof {\n  border-top: 1px solid var(--border);\n  padding-top: 1.25rem;\n  font-family: var(--text-serif);\n  font-style: italic;\n  font-size: clamp(1rem, 1.4vw, 1.3rem);\n  line-height: 1.35;\n  color: var(--secondary);\n}\n\n/* ── §3 Founder / About ── */\n\n.pfz .pfz-home__founder-grid {\n  display: grid;\n  gap: 3rem;\n  align-items: center;\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__founder-grid {\n    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);\n    gap: 4rem;\n  }\n}\n.pfz .pfz-home__founder-portrait {\n  position: relative;\n  aspect-ratio: 3/4;\n  width: 100%;\n  max-width: 28rem;\n  overflow: hidden;\n  border-radius: 18px;\n  border: 1px solid var(--border-strong);\n  background: var(--base-light);\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__founder-portrait {\n    max-width: none;\n  }\n}\n.pfz .pfz-home__founder-copy {\n  max-width: 36rem;\n}\n.pfz .pfz-home__founder-lede {\n  margin-top: 2rem;\n}\n.pfz .pfz-home__founder-body {\n  margin-top: 1.25rem;\n}\n.pfz .pfz-home__founder-cta {\n  margin-top: 2.5rem;\n  display: inline-flex;\n}\n\n/* ── §4 Branding (case wall + brand spreads) ── */\n\n.pfz .pfz-home__brand-meta-row {\n  margin-bottom: 5rem;\n}\n\n.pfz .pfz-home__brand-wall {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 1px;\n  background: var(--border-on-dark);\n  margin-bottom: 6rem;\n}\n@media (min-width: 640px) {\n  .pfz .pfz-home__brand-wall {\n    grid-template-columns: repeat(4, 1fr);\n  }\n}\n.pfz .pfz-home__brand-wall-cell {\n  position: relative;\n  aspect-ratio: 2/1;\n  overflow: hidden;\n  background: linear-gradient(\n    180deg,\n    rgba(255, 255, 255, 0.02),\n    transparent\n  );\n}\n.pfz .pfz-home__brand-wall-name {\n  position: absolute;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  font-family: var(--text-sans);\n  font-size: clamp(1.4rem, 2.4vw, 2.2rem);\n  font-weight: 500;\n  letter-spacing: -0.03em;\n  color: var(--contrast);\n}\n.pfz .pfz-home__brand-wall-foot {\n  position: absolute;\n  inset-inline: 0;\n  bottom: 0;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0.75rem 1rem;\n  background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.4));\n  font-family: var(--text-mono);\n  font-size: 10px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n}\n.pfz .pfz-home__brand-wall-foot-ind {\n  color: var(--contrast-muted);\n}\n.pfz .pfz-home__brand-wall-foot-yr {\n  color: var(--primary);\n}\n\n.pfz .pfz-home__brand-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 6rem;\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__brand-list {\n    gap: 10rem;\n  }\n}\n\n.pfz .pfz-home__brand-spread {\n  display: grid;\n  align-items: center;\n  gap: 2.5rem;\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__brand-spread {\n    grid-template-columns: repeat(12, 1fr);\n    gap: 4rem;\n  }\n}\n.pfz .pfz-home__brand-spread--flip {\n  direction: rtl;\n}\n.pfz .pfz-home__brand-spread > * {\n  direction: ltr;\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__brand-spread-mono {\n    grid-column: span 7;\n  }\n  .pfz .pfz-home__brand-spread-detail {\n    grid-column: span 5;\n  }\n}\n\n.pfz .pfz-home__brand-mono {\n  position: relative;\n  aspect-ratio: 5/4;\n  overflow: hidden;\n  border-radius: 1rem;\n  border: 1px solid var(--border-on-dark);\n  background: var(--base-light);\n}\n.pfz .pfz-home__brand-mono-bg {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n}\n.pfz .pfz-home__brand-mono-overlay {\n  position: absolute;\n  inset: 0;\n  opacity: 0.3;\n  mix-blend-mode: screen;\n  pointer-events: none;\n}\n.pfz .pfz-home__brand-mono-bracket {\n  position: absolute;\n  width: 0.75rem;\n  height: 0.75rem;\n  border-color: var(--border-on-dark);\n}\n.pfz .pfz-home__brand-mono-bracket--tl {\n  top: 1rem;\n  left: 1rem;\n  border-top: 1px solid;\n  border-left: 1px solid;\n}\n.pfz .pfz-home__brand-mono-bracket--tr {\n  top: 1rem;\n  right: 1rem;\n  border-top: 1px solid;\n  border-right: 1px solid;\n}\n.pfz .pfz-home__brand-mono-bracket--bl {\n  bottom: 1rem;\n  left: 1rem;\n  border-bottom: 1px solid;\n  border-left: 1px solid;\n}\n.pfz .pfz-home__brand-mono-bracket--br {\n  bottom: 1rem;\n  right: 1rem;\n  border-bottom: 1px solid;\n  border-right: 1px solid;\n}\n.pfz .pfz-home__brand-mono-meta {\n  position: absolute;\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  font-family: var(--text-mono);\n  font-size: 10px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--contrast-muted);\n}\n.pfz .pfz-home__brand-mono-meta--tl {\n  top: 1.5rem;\n  left: 1.5rem;\n}\n.pfz .pfz-home__brand-mono-meta--tr {\n  top: 1.5rem;\n  right: 1.5rem;\n  text-align: right;\n  color: var(--primary);\n}\n.pfz .pfz-home__brand-mono-glyph {\n  position: absolute;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  font-family: var(--text-sans);\n  font-weight: 500;\n  font-size: clamp(7rem, 18vw, 16rem);\n  letter-spacing: -0.06em;\n  line-height: 0.85;\n  color: var(--contrast);\n}\n.pfz .pfz-home__brand-mono-pal {\n  position: absolute;\n  bottom: 1.5rem;\n  left: 1.5rem;\n  display: flex;\n  height: 6px;\n  width: 8rem;\n}\n.pfz .pfz-home__brand-mono-pal > span {\n  flex: 1;\n}\n.pfz .pfz-home__brand-mono-deliv {\n  position: absolute;\n  bottom: 1.5rem;\n  right: 1.5rem;\n  text-align: right;\n  font-family: var(--text-mono);\n  font-size: 10px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--contrast-muted);\n}\n\n/* Brand spread detail column */\n.pfz .pfz-home__brand-spread-h3 {\n  margin-top: 1rem;\n  font-family: var(--text-sans);\n  font-size: clamp(2rem, 3.6vw, 3.5rem);\n  font-weight: 500;\n  letter-spacing: -0.03em;\n  line-height: 1;\n  color: var(--contrast);\n}\n.pfz .pfz-home__brand-spread-h3 .pfz-display__accent {\n  color: var(--primary);\n}\n.pfz .pfz-home__brand-spread-tag {\n  margin-top: 1rem;\n  max-width: 28rem;\n  font-family: var(--text-serif);\n  font-style: italic;\n  font-size: clamp(1.1rem, 1.5vw, 1.4rem);\n  line-height: 1.3;\n  color: var(--secondary);\n}\n.pfz .pfz-home__brand-spread-dl {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0.5rem 1.5rem;\n  margin-top: 1.5rem;\n  font-family: var(--text-mono);\n  font-size: 11px;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--contrast-muted);\n}\n.pfz .pfz-home__brand-spread-dl dt {\n  color: var(--contrast-muted-mid);\n}\n.pfz .pfz-home__brand-spread-dl dd {\n  margin: 0.125rem 0 0;\n  color: var(--contrast);\n}\n.pfz .pfz-home__brand-spread-summary {\n  margin-top: 2rem;\n  max-width: 28rem;\n  font-famil