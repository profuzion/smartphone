\"\";\n  display: inline-block;\n  height: 1px;\n  width: 1.75rem;\n  background: var(--primary);\n  transition: width 0.2s var(--ease-out);\n}\n.pfz .pfz-home__brand-spread-cta:hover::before {\n  width: 2.5rem;\n}\n\n/* ── §5 Websites ── */\n\n.pfz .pfz-home__web-grid {\n  display: grid;\n  gap: 3rem;\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__web-grid {\n    grid-template-columns: 1.1fr 1fr;\n    gap: 4rem;\n  }\n}\n.pfz .pfz-home__web-sticky-col {\n  display: none;\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__web-sticky-col {\n    display: block;\n  }\n  .pfz .pfz-home__web-sticky {\n    position: sticky;\n    top: 7rem;\n  }\n}\n\n/* Browser-frame mock — also referenced from case page CSS, so keep it\n   independent of the home class-prefix. */\n.pfz .pfz-browser {\n  background: var(--base-light);\n  border: 1px solid var(--border-strong);\n  border-radius: 12px;\n  overflow: hidden;\n  aspect-ratio: 16/10;\n  display: flex;\n  flex-direction: column;\n}\n.pfz .pfz-browser__bar {\n  display: flex;\n  align-items: center;\n  gap: 0.4rem;\n  padding: 0.5rem 0.75rem;\n  border-bottom: 1px solid var(--border);\n  background: var(--base);\n}\n.pfz .pfz-browser__dot {\n  display: inline-block;\n  width: 0.6rem;\n  height: 0.6rem;\n  border-radius: 50%;\n}\n.pfz .pfz-browser__url {\n  margin-left: 0.75rem;\n  font-family: var(--text-mono);\n  font-size: 11px;\n  letter-spacing: 0.04em;\n  color: var(--contrast-muted-mid);\n}\n.pfz .pfz-browser__body {\n  position: relative;\n  flex: 1;\n  overflow: hidden;\n  background: var(--base);\n}\n.pfz .pfz-home__web-progress {\n  margin-top: 1.5rem;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n}\n.pfz .pfz-home__web-progress ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  align-items: center;\n  gap: 0.375rem;\n}\n.pfz .pfz-home__web-progress li {\n  height: 3px;\n  width: 12px;\n  background: var(--border-strong);\n  border-radius: 3px;\n}\n.pfz .pfz-home__web-progress li.is-active {\n  width: 36px;\n  background: var(--primary);\n}\n.pfz .pfz-home__web-progress-counter {\n  font-family: var(--text-mono);\n  font-size: 11px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--contrast-muted-mid);\n}\n\n.pfz .pfz-home__web-slot-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n}\n.pfz .pfz-home__web-slot {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  border-top: 1px solid var(--border);\n  padding-block: 3rem;\n  min-height: 80vh;\n}\n.pfz .pfz-home__web-slot:first-child {\n  border-top: 0;\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__web-slot {\n    min-height: 90vh;\n  }\n}\n.pfz .pfz-home__web-slot-mobile {\n  margin-bottom: 2rem;\n}\n@media (min-width: 1024px) {\n  .pfz .pfz-home__web-slot-mobile {\n    display: none;\n  }\n}\n.pfz .pfz-home__web-slot-h3 {\n  margin-top: 1rem;\n  font-size: clamp(2rem, 3.6vw, 3.4rem);\n  font-weight: 500;\n  letter-spacing: -0.03em;\n  line-height: 0.98;\n  color: var(--contrast);\n}\n.pfz .pfz-home__web-slot-tag {\n  margin-top: 0.75rem;\n  max-width: 28rem;\n  font-family: var(--text-serif);\n  font-style: italic;\n  font-size: clamp(1.1rem, 1.4vw, 1.4rem);\n  line-height: 1.3;\n  color: var(--secondary);\n}\n.pfz .pfz-home__web-slot-outcome {\n  margin-top: 1.25rem;\n  max-width: 28rem;\n  font-family: var(--text-sans);\n  font-size: 15.5px;\n  line-height: 1.55;\n  color: var(--contrast-muted);\n}\n.pfz .pfz-home__web-slot-metrics {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 1rem;\n  margin-top: 2rem;\n}\n.pfz .pfz-home__web-slot-metrics > div {\n  border-top: 1px solid var(--border);\n  padding-top: 0.75rem;\n}\n.pfz .pfz-home__web-slot-metrics dt {\n  font-family: var(--text-mono);\n  font-size: 10px;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--contrast-muted-mid);\n}\n.pfz .pfz-home__web-slo